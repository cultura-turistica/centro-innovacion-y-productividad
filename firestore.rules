rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Permitir guardar encuestas públicamente desde el frontend
    match /course_surveys/{surveyId} {
      allow create: if true;
    }
    
    // Permitir leer un certificado SOLO si se conoce su ID exacto
    match /certificados/{certificadoId} {
      allow get: if true;
    }
  }
}
